<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><meta name="theme-color" content="#09060f"><title>ZEYOS 2.0 💜</title><style>:root{--bg:#09060f;--card:#15101e;--p:#9b5cff;--pink:#ff5fa2;--text:#fff;--muted:#aaa0b5}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top,#27123c,#09060f 55%);color:var(--text);font-family:system-ui,-apple-system,sans-serif}#app{max-width:520px;margin:auto;min-height:100vh;padding:18px}.screen{display:none;min-height:100vh;padding-bottom:90px}.active{display:block}.card{background:linear-gradient(145deg,#1d1428,#100b16);border:1px solid #ffffff14;border-radius:24px;padding:18px;margin:12px 0}.logo{font-size:42px;font-weight:1000;background:linear-gradient(90deg,#fff,#c084fc,#ff7daf);-webkit-background-clip:text;color:transparent}.muted{color:var(--muted)}button{font:inherit;color:white;border:0;cursor:pointer}.btn{width:100%;padding:15px;border-radius:16px;background:linear-gradient(135deg,#7c3aed,#ec4899);font-weight:900;margin-top:10px}.btn.alt{background:#ffffff0b;border:1px solid #ffffff12}.input{width:100%;padding:15px;border-radius:15px;background:#0d0913;color:white;border:1px solid #ffffff15;margin-top:9px;outline:none}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.game{min-height:135px;text-align:left;border-radius:21px;padding:15px;background:#ffffff08;border:1px solid #ffffff10;color:#fff}.game b,.game small{display:block;margin-top:7px}.game small{color:var(--muted)}.game .ico{font-size:34px}.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}.back{width:42px;height:42px;border-radius:14px;background:#ffffff0b}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{text-align:center;background:#ffffff08;border:1px solid #ffffff10;border-radius:17px;padding:12px}.stat b{display:block;font-size:21px}.xp{height:8px;background:#30253a;border-radius:20px;overflow:hidden}.xp i{display:block;height:100%;background:linear-gradient(90deg,#8b5cf6,#f472b6);width:0}.upload{display:block;text-align:center;padding:14px;border:1px dashed #76558d;border-radius:15px;margin:10px 0;color:#ddd}.upload input{display:none}.area{height:420px;position:relative;overflow:hidden;border-radius:24px;background:#0b0710;border:1px solid #ffffff12}.target{position:absolute;right:16px;bottom:16px;width:120px;height:120px;object-fit:cover;border-radius:22px;border:4px solid white}.throw{position:absolute;left:20px;bottom:22px;font-size:48px;touch-action:none}.feedback{position:absolute;left:50%;top:40%;font-size:38px;font-weight:1000;opacity:0;transform:translate(-50%,-50%)}.feedback.show{animation:pop .8s}.memory{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.mcard{aspect-ratio:1;border-radius:16px;background:linear-gradient(145deg,#2c193d,#130c1b);display:grid;place-items:center;font-size:28px;border:1px solid #ffffff12}.open{background:linear-gradient(135deg,#7c3aed,#db2777)}@keyframes pop{20%{opacity:1;transform:translate(-50%,-50%) scale(1.2)}100%{opacity:0;transform:translate(-50%,-90%) scale(1)}}#heart{width:100%;height:390px;background:#030205;border-radius:24px} .bottom{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(520px,100%);display:flex;background:#0a0710eF;backdrop-filter:blur(18px);padding:10px;gap:5px;border-top:1px solid #ffffff12}.nav{flex:1;background:transparent;padding:8px;color:#aaa;font-size:11px}.nav strong{display:block;font-size:20px}.reaction{height:330px;border-radius:25px;display:grid;place-items:center;text-align:center;background:#4c1010}.reaction.go{background:#08783b}.word{font-size:28px;text-align:center;padding:30px;border-radius:22px;background:#ffffff08;letter-spacing:4px}.hidden{display:none!important}</style></head><body><div id="app">
<section id="welcome" class="screen active"><div style="min-height:100vh;display:flex;align-items:center"><div class="card" style="text-align:center;width:100%"><div style="font-size:70px">💜</div><div class="logo">ZEYOS 2.0</div><p class="muted">İki kişi için tasarlanmış küçük bir dünya. Oyunlar, fotoğraflar, anılar ve gizli sürprizler.</p><button class="btn" onclick="go('login')">Giriş Yap ✨</button></div></div></section>
<section id="login" class="screen"><div style="padding-top:25vh"><div class="card"><div class="logo">ZEYOS 2.0</div><p class="muted">Sizin dünyanıza giriş yap.</p><input id="name" class="input" placeholder="Adın"><input id="password" class="input" type="password" placeholder="Şifren"><button class="btn" onclick="login()">Giriş Yap 💗</button></div></div></section>
<section id="home" class="screen"><div class="top"><div><h2>Merhaba, <span id="hello">Aşk</span> 💜</h2><small class="muted">Bugün ne yapıyoruz?</small></div><button class="back" onclick="go('profile')">👤</button></div><div class="card"><b>Seviye <span id="level">1</span></b><span style="float:right">⭐ <span id="coins">0</span></span><div class="xp" style="margin-top:10px"><i id="xp"></i></div><small class="muted" id="xptxt">0 XP</small></div><div class="card" style="text-align:center"><small class="muted">BUGÜNÜN MESAJI</small><p><b id="daily">Seninle her gün biraz daha güzel. 💜</b></p></div><div class="stats"><div class="stat"><b id="games">0</b>Oyun</div><div class="stat"><b id="wins">0</b>Zafer</div><div class="stat"><b id="streak">1</b>Seri</div></div><h3>Oyunlar</h3><div class="grid"><button class="game" onclick="go('memory')"><span class="ico">🧠</span><b>Eşleştirme</b><small>Çiftleri bul.</small></button><button class="game" onclick="go('flower')"><span class="ico">🌸</span><b>Çiçek Ball</b><small>Fotoğrafı hedef yap.</small></button><button class="game" onclick="go('canii')"><span class="ico">🧸</span><b>Canii Basket</b><small>Yastığı fotoğrafa gönder.</small></button><button class="game" onclick="go('reaction')"><span class="ico">⚡</span><b>Refleks</b><small>Yeşilde dokun.</small></button><button class="game" onclick="go('word')"><span class="ico">🔤</span><b>Kelime Avı</b><small>Karışık harfleri çöz.</small></button><button class="game" onclick="go('rps')"><span class="ico">✊</span><b>Taş Kağıt Makas</b><small>ZEYOS'a karşı.</small></button><button class="game" onclick="go('love')"><span class="ico">💗</span><b>Sevgi Alanı</b><small>Kalpleri çoğalt.</small></button><button class="game" onclick="go('memories')"><span class="ico">📸</span><b>Anılar</b><small>Fotoğraf kutusu.</small></button><button class="game" onclick="go('secret')"><span class="ico">🔐</span><b>Gizli Oda</b><small>Şifreli sürpriz.</small></button><button class="game" onclick="go('profile')"><span class="ico">🏆</span><b>Profil</b><small>İstatistikler.</small></button></div></section>
<section id="memory" class="screen"><div class="top"><button class="back" onclick="go('home')">‹</button><h2>Eşleştirme 🧠</h2><span id="moves">0</span></div><div class="card"><small class="muted">Aynı sembolleri bul. Her tamamlanan tur XP verir.</small></div><div id="board" class="memory"></div><button class="btn" onclick="memoryStart()">Yeni Oyun</button></section>
<section id="flower" class="screen"><div class="top"><button class="back" onclick="go('home')">‹</button><h2>Çiçek Ball 🌸</h2></div><div class="card"><b>Pota kaldırıldı.</b><p class="muted">Kendi fotoğrafını hedef olarak yükle. Çiçeği fotoğrafa sürükle. Yakın isabet PERFECT!</p></div><label class="upload">📷 Hedef fotoğrafı seç<input type="file" accept="image/*" onchange="photo('flower',this)"></label><div class="area" id="fa"><img id="ft" class="target"><div id="fo" class="throw">🌸</div><div id="ff" class="feedback">PERFECT!</div></div></section>
<section id="canii" class="screen"><div class="top"><button class="back" onclick="go('home')">‹</button><h2>Canii Basket 🧸</h2></div><div class="card"><b>Hedef artık fotoğraf.</b><p class="muted">Yastığı sürükleyerek seçtiğin fotoğrafa isabet ettir.</p></div><label class="upload">📷 Hedef fotoğrafı seç<input type="file" accept="image/*" onchange="photo('canii',this)"></label><div class="area" id="ca"><img id="ct" class="target"><div id="co" class="throw">🧸</div><div id="cf" class="feedback">LOVE HIT!</div></div></section>
<section id="reaction" class="screen"><div class="top"><button class="back" onclick="go('home')">‹</button><h2>Refleks ⚡</h2></div><div id="rb" class="reaction" onclick="reactTap()"><div><div id="rt" style="font-size:55px;font-weight:1000">HAZIR</div><small id="rs">Yeni deneme</small></div></div><button class="btn" onclick="reactStart()">Başlat</button></section>
<section id="word" class="screen"><div class="top"><button class="back" onclick="go('home')">‹</button><h2>Kelime Avı 🔤</h2></div><div class="card"><div id="wb" class="word"></div><input id="wi" class="input" placeholder="Kelimeyi yaz"><button class="btn" onclick="wordCheck()">Kontrol</button></div></section>
<section id="rps" class="screen"><div class="top"><button class="back" onclick="go('home')">‹</button><h2>Taş Kağıt Makas</h2></div><div class="card" style="text-align:center"><h2 id="rr">Seçimini yap</h2><div class="grid"><button class="btn" onclick="rps('taş')">✊</button><button class="btn" onclick="rps('kağıt')">🖐️</button><button class="btn" onclick="rps('makas')">✌️</button></div></div></section>
<section id="love" class="screen"><div class="top"><button class="back" onclick="go('home')">‹</button><h2>Sevgi Alanı 💗</h2></div><canvas id="heart"></canvas><div class="card" style="text-align:center"><b id="loveText">İyi ki varsın.</b><p class="muted">Ekrana dokun.</p></div></section>
<section id="memories" class="screen"><div class="top"><button class="back" onclick="go('home')">‹</button><h2>Anılar 📸</h2></div><div class="card"><label class="upload">📷 Fotoğraf ekle<input type="file" accept="image/*" onchange="addMemory(this)"></label></div><div id="ml"></div></section>
<section id="secret" class="screen"><div class="top"><button class="back" onclick="go('home')">‹</button><h2>Gizli Oda 🔐</h2></div><div class="card"><p class="muted">ZEYOS'un gizli şifresi</p><input id="pin" class="input" placeholder="Şifre"><button class="btn" onclick="secret()">Kilidi Aç</button></div><div id="secretText" class="card hidden"><h2>Sadece Senin İçin 💜</h2><p style="line-height:1.8">Bu alan sizin için. Buraya istediğiniz özel mesajı, tarihi veya anıyı yazabilirsiniz.</p></div></section>
<section id="profile" class="screen"><div class="top"><button class="back" onclick="go('home')">‹</button><h2>Profil 👤</h2></div><div class="card" style="text-align:center"><div style="font-size:60px">💜</div><h2 id="pn">ZEYOS</h2><p class="muted">ZEYOS 2.0</p></div><div class="stats"><div class="stat"><b id="pg">0</b>Oyun</div><div class="stat"><b id="pw">0</b>Zafer</div><div class="stat"><b id="px">0</b>XP</div></div><button class="btn alt" onclick="resetAll()">İlerlemeyi Sıfırla</button><button class="btn" onclick="logout()">Çıkış Yap</button></section>
<div id="bottom" class="bottom hidden"><button class="nav" onclick="go('home')"><strong>⌂</strong>Ana</button><button class="nav" onclick="go('memory')"><strong>🧠</strong>Oyun</button><button class="nav" onclick="go('memories')"><strong>📸</strong>Anılar</button><button class="nav" onclick="go('profile')"><strong>☻</strong>Profil</button></div></div>
<script>
const $=id=>document.getElementById(id);let s=JSON.parse(localStorage.zeyos20||'null')||{name:'Aşk',xp:0,level:1,coins:0,games:0,wins:0,streak:1,flower:0,canii:0,memories:[]};let current='welcome';
function save(){localStorage.zeyos20=JSON.stringify(s);ui()}function go(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));$(id).classList.add('active');current=id;$('.bottom')?.classList.toggle('hidden',!['home','memory','memories','profile'].includes(id));if(id==='memory')memoryStart();if(id==='word')newWord();if(id==='love')loveInit();ui();scrollTo(0,0)}
function login(){s.name=$('name').value.trim()||'Aşk';save();go('home');alert('Hoş geldin '+s.name+' 💜')}function logout(){go('login')}
function xp(n){s.xp+=n;s.coins+=Math.max(1,Math.floor(n/5));while(s.xp>=s.level*100)s.level++;save()}function done(win=true,n=12){s.games++;if(win)s.wins++;xp(n)}
function ui(){$('hello').textContent=s.name;$('pn').textContent=s.name;$('level').textContent=s.level;$('coins').textContent=s.coins;$('games').textContent=s.games;$('wins').textContent=s.wins;$('streak').textContent=s.streak;$('pg').textContent=s.games;$('pw').textContent=s.wins;$('px').textContent=s.xp;let prev=(s.level-1)*100,need=s.level*100;$('xp').style.width=Math.min(100,(s.xp-prev)/(need-prev)*100)+'%';$('xptxt').textContent=(s.xp-prev)+' / '+(need-prev)+' XP';renderMemories()}
function photo(t,i){let f=i.files[0];if(!f)return;let r=new FileReader();r.onload=e=>{let id=t==='flower'?'ft':'ct';$(id).src=e.target.result;localStorage['z_'+t]=e.target.result};r.readAsDataURL(f)}
function loadPhotos(){if(localStorage.z_flower)$('ft').src=localStorage.z_flower;if(localStorage.z_canii)$('ct').src=localStorage.z_canii}loadPhotos();
function throwGame(t){let o=$(t==='flower'?'fo':'co'),a=$(t==='flower'?'fa':'ca'),im=$(t==='flower'?'ft':'ct');let d=o.getBoundingClientRect(),r=im.getBoundingClientRect(),cx=d.left+d.width/2,cy=d.top+d.height/2,tx=r.left+r.width/2,ty=r.top+r.height/2,dist=Math.hypot(cx-tx,cy-ty);if(dist<r.width*.65){let perfect=dist<r.width*.22;$(t==='flower'?'ff':'cf').classList.remove('show');void $(t==='flower'?'ff':'cf').offsetWidth;$(t==='flower'?'ff':'cf').classList.add('show');if(t==='flower')s.flower+=perfect?3:1;else s.canii+=perfect?3:1;done(true,perfect?25:12);setTimeout(()=>{o.style.left='20px';o.style.top='';o.style.bottom='22px'},500)}else{xp(2);o.style.left='20px';o.style.top='';o.style.bottom='22px'}}
function drag(id,type){let o=$(id),down=false,sx,sy,ox,oy;o.addEventListener('pointerdown',e=>{down=true;o.setPointerCapture(e.pointerId);sx=e.clientX;sy=e.clientY;let r=o.getBoundingClientRect();ox=r.left;oy=r.top});o.addEventListener('pointermove',e=>{if(!down)return;let a=$(type==='flower'?'fa':'ca').getBoundingClientRect();o.style.left=Math.max(0,Math.min(a.width-70,ox+e.clientX-sx-a.left))+'px';o.style.top=Math.max(0,Math.min(a.height-70,oy+e.clientY-sy-a.top))+'px';o.style.bottom='auto'});o.addEventListener('pointerup',()=>{down=false;throwGame(type)})}drag('fo','flower');drag('co','canii');
let first=null,busy=false,match=0;function memoryStart(){let b=$('board');b.innerHTML='';first=null;busy=false;match=0;let sy=['💜','🩷','🌸','🦋','⭐','🌙','🍓','🧸'];[...sy,...sy].sort(()=>Math.random()-.5).forEach(v=>{let x=document.createElement('button');x.className='mcard';x.textContent='❔';x.dataset.v=v;x.onclick=()=>{if(busy||x.classList.contains('open'))return;x.classList.add('open');x.textContent=v;if(!first){first=x;return}if(first.dataset.v===v){match++;first=null;done(true,18);if(match===sy.length)toast('Tüm çiftleri buldun! 🏆')}else{busy=true;setTimeout(()=>{first.classList.remove('open');x.classList.remove('open');first.textContent=x.textContent='❔';first=null;busy=false},550)}};b.appendChild(x)})}
let react='idle',rtimer,rs;function reactStart(){clearTimeout(rtimer);react='wait';$('rb').className='reaction';$('rt').textContent='BEKLE';rtimer=setTimeout(()=>{react='go';rs=performance.now();$('rb').className='reaction go';$('rt').textContent='ŞİMDİ!'},1000+Math.random()*2500)}function reactTap(){if(react==='wait'){clearTimeout(rtimer);$('rt').textContent='ERKEN 😄';return}if(react!=='go')return;let ms=Math.round(performance.now()-rs);react='idle';$('rt').textContent=ms+' ms';done(true,Math.max(8,35-Math.floor(ms/25)))}
let words=['SEVGİ','ZEYOS','HAFSO','AŞK','KALP','GÜLÜŞ','MUTLULUK','ANIMIZ','BEBEĞİM'];let word='';function newWord(){word=words[Math.floor(Math.random()*words.length)];$('wb').textContent=word.split('').sort(()=>Math.random()-.5).join(' • ');$('wi').value=''}function wordCheck(){if($('wi').value.trim().toLocaleUpperCase('tr-TR')===word){done(true,20);toast('Doğru! 🔥');newWord()}else toast('Tekrar dene 😄')}
function rps(u){let a=['taş','kağıt','makas'],c=a[Math.floor(Math.random()*3)];if(u===c){$('rr').textContent='Berabere 🤝';return}let w=(u==='taş'&&c==='makas')||(u==='kağıt'&&c==='taş')||(u==='makas'&&c==='kağıt');$('rr').textContent=w?'Kazandın 💜':'Bu tur ZEYOS aldı 😈';done(w,w?12:3)}
function addMemory(i){let f=i.files[0];if(!f)return;let r=new FileReader();r.onload=e=>{s.memories.unshift(e.target.result);s.memories=s.memories.slice(0,12);xp(5);save()};r.readAsDataURL(f)}function renderMemories(){let b=$('ml');if(!b)return;b.innerHTML=s.memories.map((x,i)=>'<div class="card"><img src="'+x+'" style="width:100%;border-radius:20px"><small class="muted">Anı #'+(i+1)+'</small></div>').join('')}
function secret(){if($('pin').value==='ZEYOS'||$('pin').value==='2012'){$('secretText').classList.remove('hidden');xp(15)}else toast('Şifre yanlış 😈')}
let ctx=$('heart').getContext('2d'),hs=[];function loveInit(){let r=$('heart').getBoundingClientRect();$('heart').width=r.width*devicePixelRatio;$('heart').height=r.height*devicePixelRatio;ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);hs=Array.from({length:30},()=>({x:Math.random()*r.width,y:Math.random()*r.height,v:.3+Math.random(),s:10+Math.random()*18}));loveDraw()}function loveDraw(){if(current!=='love')return;let r=$('heart').getBoundingClientRect();ctx.clearRect(0,0,r.width,r.height);ctx.fillStyle='#ff5fa2';hs.forEach(h=>{h.y-=h.v;if(h.y<0)h.y=r.height;ctx.font=h.s+'px serif';ctx.fillText('♥',h.x,h.y)});requestAnimationFrame(loveDraw)}$('heart').onclick=()=>{hs.push({x:Math.random()*$('heart').clientWidth,y:$('heart').clientHeight-10,v:1,s:22});xp(1);$('loveText').textContent='Bu kalp senin için. 💜'};
function toast(msg){let t=document.getElementById('toast');if(!t){t=document.createElement('div');t.id='toast';t.style='position:fixed;left:50%;bottom:85px;transform:translateX(-50%) translateY(20px);background:#24152f;color:#fff;padding:13px 18px;border:1px solid #ffffff18;border-radius:16px;z-index:9999;opacity:0;transition:.25s;font-weight:800;max-width:90%;text-align:center;box-shadow:0 10px 35px #0008';document.body.appendChild(t)}t.textContent=msg;t.style.opacity='1';t.style.transform='translateX(-50%) translateY(0)';clearTimeout(window.__toast);window.__toast=setTimeout(()=>{t.style.opacity='0';t.style.transform='translateX(-50%) translateY(20px)'},1800)}
function resetAll(){if(confirm('Tüm ilerleme silinsin mi?')){localStorage.clear();location.reload()}}ui();newWord();
<!-- ZEYOS 2.0 ARCHITECTURE NOTE 0001: mobile-first romantic app / local-only storage / no external dependency. -->
